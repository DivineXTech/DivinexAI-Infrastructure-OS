# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Supabase (server-side secrets never exposed to the client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Durable execution (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Video generation provider (pluggable; e.g. Runway, Luma, Pika) ---
VIDEO_PROVIDER=
VIDEO_PROVIDER_API_KEY=

# --- Voice / TTS provider (e.g. ElevenLabs) ---
VOICE_PROVIDER=
VOICE_PROVIDER_API_KEY=

# --- Music provider ---
MUSIC_PROVIDER=
MUSIC_PROVIDER_API_KEY=

# --- Storage provider (defaults to Supabase Storage) ---
STORAGE_PROVIDER=supabase

# --- Publishing provider (e.g. YouTube, TikTok) ---
PUBLISHING_PROVIDER=
PUBLISHING_PROVIDER_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
