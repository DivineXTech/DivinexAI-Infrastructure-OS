# ------------------------------------------------------------------
# The Flavor Station (native) — environment variable template
# ------------------------------------------------------------------
# Copy to .env.development / .env.staging / .env.production and fill in.
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time
# (same convention as the web app's VITE_ prefix) — never put a secret
# behind this prefix. See docs/ENVIRONMENT.md.
# ------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"
EXPO_PUBLIC_SUPABASE_PROJECT_ID="<project-ref>"
EXPO_PUBLIC_APP_ENV="development"
