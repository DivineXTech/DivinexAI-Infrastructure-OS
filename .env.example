# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.

# --- Supabase (required) ---
# Project URL and anon key from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key: server-only, bypasses Row-Level Security. Required for
# scripts/seed.ts and any future admin tooling. NEVER expose to the client
# and NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Payments (optional; defaults to mock mode) ---
# "mock" runs the payments layer in sandbox/mock mode with no external
# calls. Set to "live" only once a real provider is wired up.
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=

# --- DivinexAI service integrations (optional; mock implementations used
# when unset — see lib/divinexai) ---
DIVINEXAI_API_BASE_URL=
DIVINEXAI_API_KEY=
