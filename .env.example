# Every credential below is OPTIONAL. Any capability left unconfigured runs
# in Simulation Mode against a deterministic mock provider instead of
# failing — see the /providers screen for live status of each one, and
# src/env.ts for the Zod schema that validates these at startup.

# --- Anthropic (idea generation, scripts, scene plans, structured output) ---
# Without this, idea/script generation runs through a deterministic mock
# generator clearly flagged as simulated — never passed off as real.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Supabase (Postgres, Auth, Storage, Realtime, RLS) ---
# Without all three, storage falls back to an in-memory/local mock and
# persistence-backed features (runs, audit log, provider setup screen data)
# are unavailable — set all three together or none.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=atlas-media

# --- Durable execution (Inngest) ---
# For local dev, set INNGEST_DEV=1 and run `npx inngest-cli dev` alongside
# `npm run dev` — this tells the SDK to skip signing-key verification and
# talk to the local dev server instead of Inngest Cloud. Unset INNGEST_DEV
# and set both keys below for production/Inngest Cloud.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- ElevenLabs (narration — Multilingual v2) ---
# Both are required together to use real ElevenLabs narration. Without
# them, narration falls back to a deterministic mock audio track.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Video generation provider (pluggable; vendor-neutral HTTP contract) ---
# Set VIDEO_PROVIDER=http and both URL/key vars to use a real vendor behind
# the generic submit-job/get-status/webhook contract in
# src/providers/http/video.ts. Leave as "mock" (default) to simulate.
VIDEO_PROVIDER=mock
VIDEO_PROVIDER_BASE_URL=
VIDEO_PROVIDER_API_KEY=
VIDEO_WEBHOOK_SECRET=

# --- Music provider (pluggable; vendor-neutral HTTP contract) ---
MUSIC_PROVIDER=mock
MUSIC_PROVIDER_BASE_URL=
MUSIC_PROVIDER_API_KEY=
MUSIC_WEBHOOK_SECRET=

# --- Publishing provider (pluggable; vendor-neutral HTTP contract) ---
PUBLISHING_PROVIDER=mock
PUBLISHING_PROVIDER_BASE_URL=
PUBLISHING_PROVIDER_API_KEY=

# --- Composition (Remotion + FFmpeg) ---
# Path to an ffmpeg binary with libx264/aac support. If missing or
# unresolvable at runtime, composition falls back to a mock composer that
# produces a clearly watermarked placeholder instead of failing the run.
FFMPEG_PATH=ffmpeg
# Override Remotion's headless Chromium executable (e.g. a system Chrome
# path) instead of letting Remotion download/manage its own.
REMOTION_CHROMIUM_EXECUTABLE=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
