# Site
# Public base URL used to build absolute links in emails (Chapter 12 access,
# status, unsubscribe) and Open Graph tags. Set this to your production
# domain when you deploy, e.g. https://blueprint.divinexai.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Postgres + RLS)
# Leave unset to run against the in-memory dev fallback (data does not
# persist across restarts). See SETUP.md to provision a real project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
# Leave unset to log emails to the console instead of sending them.
RESEND_API_KEY=
RESEND_FROM_EMAIL="The Billionaire Blueprint <launch@blueprint.divinexai.com>"

# Secure link signing
# Required in production. Signs the Chapter 12 / status / unsubscribe /
# admin-session / ebook-download "magic links". Generate with: openssl rand -hex 32
APP_TOKEN_SECRET=

# Production environment detection
# Set explicitly to "production" on any non-Vercel host (a VPS, Docker,
# Railway, Fly.io, ...) to get the same hard-fail protections Vercel gets
# automatically via VERCEL_ENV. Leave unset on Vercel. Valid values:
# production | preview | development.
APP_ENV=

# Chapter 12 private PDF storage (Supabase Storage)
# Optional: only used once a PDF is uploaded to the private bucket created
# by supabase/migrations/0002_chapter12_access_control.sql. Until then the
# page falls back to the inline text chapter automatically.
CHAPTER12_STORAGE_BUCKET=chapter12-private
CHAPTER12_STORAGE_PATH=chapter-12.pdf

# Admin dashboard (/admin)
# Single shared operator password, minimum 12 characters. There is no dev
# fallback for this one — the dashboard is simply unreachable until it's set.
ADMIN_PASSWORD=

# Stripe (ebook purchase — checkout stays disabled until explicitly turned on)
# Leave unset / NEXT_PUBLIC_CHECKOUT_ENABLED unset-or-false to keep the Buy
# Now button hidden and /api/checkout refusing requests, regardless of
# whether Stripe credentials below are set. See SETUP.md before flipping
# this on — founder approval required.
NEXT_PUBLIC_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The verified Billionaire Blueprint 2.0 Extended Edition product. Only
# change this if the product is recreated in Stripe under a new ID.
STRIPE_PRODUCT_ID=prod_UtmvlaWO7E0RY1

# Full ebook private PDF storage (Supabase Storage) — same pattern as
# Chapter 12 (CHAPTER12_STORAGE_BUCKET above). Optional: falls back to
# "processing" messaging until the file is uploaded.
EBOOK_STORAGE_BUCKET=ebook-private
EBOOK_STORAGE_PATH=the-billionaire-blueprint-2.0.pdf

# Support contact shown in legal pages and emails
NEXT_PUBLIC_SUPPORT_EMAIL=hello@divinexai.com

# Social destinations for the Follow / Like / Share supporter actions
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_TIKTOK_URL=
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_LAUNCH_POST_URL=
NEXT_PUBLIC_SHARE_URL=

# Analytics (optional — both are no-ops until configured)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
