# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.
#
# Client-accessible (safe to ship to the browser): everything prefixed
# NEXT_PUBLIC_ — and *only* those. Server-only (must never reach client
# code or a client bundle): SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY,
# DIVINEXAI_API_KEY. See lib/env.ts (server) vs lib/env.client.ts (client)
# — the client module's schema is intentionally the only place allowed to
# read a NEXT_PUBLIC_* value for browser use.

# --- Supabase (required) ---
# Project URL and anon key from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key: server-only, bypasses Row-Level Security. Required for
# scripts/seed.ts, the tenant-creation Server Action, and any future admin
# tooling. NEVER expose to the client and NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application URL (required; defaults to localhost for local dev) ---
# Absolute base URL of this deployment. Used for auth redirect URLs,
# canonical/OG metadata, and sitemap generation — must be the real public
# URL in any non-local environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payments (optional; defaults to mock mode) ---
# "mock" runs the payments layer in sandbox/mock mode with no external
# calls. Set to "live" only once a real provider is wired up.
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=

# --- DivinexAI service integrations (optional; mock implementations used
# when unset — see lib/divinexai) ---
DIVINEXAI_API_BASE_URL=
DIVINEXAI_API_KEY=

# --- Seed-mode control (dev-only; required to run scripts/seed.ts) ---
# Must be the literal string "true" to allow scripts/seed.ts to run, and
# lib/env.ts refuses to start at all if this is "true" while
# NODE_ENV=production — two independent gates against seeding a real
# environment. Leave unset/"false" everywhere except your own local
# machine or a disposable dev/test Supabase project.
SEED_MODE_ENABLED=false

# --- Test-user configuration (integration/e2e tests only — never read by
# the application itself; see tests/integration and docs/TESTING.md) ---
# Populated by `npm run seed` against the tenant/user identities defined in
# scripts/seed.ts. Do not put real user credentials here.
TEST_TENANT_A_SLUG=kushprintco
TEST_TENANT_B_SLUG=demo-isolation-tenant
TEST_USER_OWNER_A_EMAIL=owner@demo.kushprintco.local
TEST_USER_DESIGNER_A_EMAIL=designer@demo.kushprintco.local
TEST_USER_PRODUCTION_A_EMAIL=production@demo.kushprintco.local
TEST_USER_OWNER_B_EMAIL=owner@demo.isolation-tenant.local
TEST_USER_NO_TENANT_EMAIL=no-tenant@demo.kushprintco.local
TEST_USER_SUPER_ADMIN_EMAIL=admin@demo.kushprintco.local
TEST_USER_MULTI_TENANT_EMAIL=multi-tenant@demo.kushprintco.local
# All seeded demo accounts share this password (see scripts/seed.ts) — it
# is not a secret, it only ever exists in disposable dev/test projects.
TEST_USER_PASSWORD=demo-password-123!
