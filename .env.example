# Root environment file. Copy to `.env` (`cp .env.example .env`) and fill in
# real values from your Supabase project settings. Never commit `.env`.

# ---- Supabase ----
# Project URL and keys, from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# SERVICE ROLE KEY BYPASSES ROW-LEVEL SECURITY. Server-only. Never expose to
# the browser, never prefix with NEXT_PUBLIC_, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Local test database (packages/shared tenant-isolation tests) ----
# Defaults below match a plain local Postgres instance with the `authenticated`
# test role created per docs/agentflow-v2/adr/ADR-0012-testing-framework.md.
# Not used against a real Supabase project — these are for the
# packages/shared/test suite only.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agentflow_test
TEST_DATABASE_URL_AUTHENTICATED=postgres://authenticated:authenticated@127.0.0.1:5432/agentflow_test
