# Copy to .env.local and fill in real values. Never commit .env.local.

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="FlowraMarket Africa"

# --- Supabase ------------------------------------------------------------
# From your Supabase project settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row-Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres connection string, used by scripts/db-migrate-local.sh
# for local migration validation. Not required by the Next.js app itself
# (the app talks to Supabase over its REST/Auth/Storage APIs).
DATABASE_URL=

# --- Payments --------------------------------------------------------------
# "mock" (default) uses the in-repo MockPaymentProvider — no real money moves.
# "live" is reserved for Phase 2 once a real provider adapter is wired up.
PAYMENT_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# --- Email (Phase 3, not yet wired up) --------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# --- AI Creator Studio (Phase 3, not yet wired up) --------------------------
AI_PROVIDER=
AI_API_KEY=

# --- Storage -----------------------------------------------------------
STORAGE_PROVIDER=supabase

# --- Platform defaults -------------------------------------------------
PLATFORM_DEFAULT_CURRENCY=USD
PLATFORM_SUPPORT_EMAIL=support@flowramarket.africa
# Comma-separated emails. First one is granted super_admin by scripts/seed.ts.
ADMIN_EMAIL_ALLOWLIST=

# --- Jobs / cron ---------------------------------------------------------
CRON_SECRET=
ENCRYPTION_KEY=
